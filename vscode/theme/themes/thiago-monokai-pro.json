    "terminalCursor.background": "#222122",
    "terminal.selectionBackground": "#5B595CB0",
    "terminal.ansiBlack": "#222122",
    "terminal.ansiRed": "#FF6188",
    "terminal.ansiGreen": "#A9DC76",
    "terminal.ansiYellow": "#FFD866",
    "terminal.ansiBlue": "#FC9867",
    "terminal.ansiMagenta": "#AB9DF2",
    "terminal.ansiCyan": "#78DCE8",
    "terminal.ansiWhite": "#FDF9F3",
    "terminal.ansiBrightBlack": "#908E8F",
    "terminal.ansiBrightRed": "#FF6188",
    "terminal.ansiBrightGreen": "#A9DC76",
    "terminal.ansiBrightYellow": "#FFD866",
    "terminal.ansiBrightBlue": "#FC9867",
    "terminal.ansiBrightMagenta": "#AB9DF2",
    "terminal.ansiBrightCyan": "#78DCE8",
    "terminal.ansiBrightWhite": "#FDF9F3"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#908E8F", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string", "string.template"], "settings": { "foreground": "#FFD866" } },
    { "scope": ["constant.character.escape", "constant.other.placeholder"], "settings": { "foreground": "#AB9DF2" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#AB9DF2" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator", "keyword.control"], "settings": { "foreground": "#FF6188" } },
    { "scope": ["storage.type.function", "storage.type.class", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#78DCE8", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#A9DC76" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#78DCE8" } },
    { "scope": ["variable.parameter", "meta.parameter", "entity.name.variable.parameter"], "settings": { "foreground": "#FC9867", "fontStyle": "italic" } },
    { "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"], "settings": { "foreground": "#FDF9F3" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#C1C0C0", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "meta.property-name", "support.variable.property"], "settings": { "foreground": "#FDF9F3" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"], "settings": { "foreground": "#FF6188" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#78DCE8", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator", "meta.annotation"], "settings": { "foreground": "#A9DC76", "fontStyle": "italic" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "entity.name.package"], "settings": { "foreground": "#FDF9F3" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#939293" } },
    { "scope": ["support.type.property-name", "support.type.property-name.json"], "settings": { "foreground": "#78DCE8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FFD866", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#AB9DF2" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#78DCE8" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#A9DC76" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#FF6188" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#FC9867" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6188", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#FC9867", "italic": true },
    "function": "#A9DC76",
    "method": "#A9DC76",
    "class": "#78DCE8",
    "type": "#78DCE8",
    "interface": "#78DCE8",
    "enum": "#78DCE8",
    "enumMember": "#AB9DF2",
    "variable.readonly": "#AB9DF2",
    "property": "#FDF9F3",
    "namespace": "#FDF9F3",
    "selfParameter": { "foreground": "#C1C0C0", "italic": true }
  }
}
