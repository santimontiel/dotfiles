    "activityBar.activeBorder": "#FFD866",
    "activityBarBadge.background": "#FFD866",
    "activityBarBadge.foreground": "#222122",
    "sideBar.background": "#1A191A",
    "sideBar.foreground": "#C1C0C0",
    "sideBar.border": "#121112",
    "sideBarTitle.foreground": "#908E8F",
    "sideBarSectionHeader.background": "#1A191A",
    "sideBarSectionHeader.foreground": "#908E8F",
    "list.activeSelectionBackground": "#2E2D2F",
    "list.activeSelectionForeground": "#FFD866",
    "list.inactiveSelectionBackground": "#2E2D2F",
    "list.hoverBackground": "#282729",
    "list.highlightForeground": "#FFD866",
    "list.focusOutline": "#00000000",
    "list.errorForeground": "#FF6188",
    "list.warningForeground": "#FC9867",
    "gitDecoration.modifiedResourceForeground": "#FC9867",
    "gitDecoration.untrackedResourceForeground": "#A9DC76",
    "gitDecoration.addedResourceForeground": "#A9DC76",
    "gitDecoration.deletedResourceForeground": "#FF6188",
    "gitDecoration.ignoredResourceForeground": "#6D6B6E",
    "gitDecoration.conflictingResourceForeground": "#AB9DF2",

    "titleBar.activeBackground": "#1A191A",
