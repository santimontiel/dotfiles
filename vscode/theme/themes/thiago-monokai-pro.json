    "input.background": "#2E2D2F",
    "input.foreground": "#FDF9F3",
    "input.border": "#5B595C",
    "input.placeholderForeground": "#908E8F",
    "inputOption.activeBorder": "#FFD866",
    "dropdown.background": "#2E2D2F",
    "dropdown.border": "#5B595C",
    "button.background": "#FFD866",
    "button.foreground": "#222122",
